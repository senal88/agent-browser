# Google Cloud Console: OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173 (and production URL)
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# Optional API key for other Google APIs (not required for Drive upload via OAuth)
VITE_GOOGLE_API_KEY=sua_api_key_aqui

# OAuth scope: access only to files created by this app
VITE_GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# Default Drive folder name for NotebookLM artifacts
VITE_DEFAULT_FOLDER_NAME=40_Dias_SMA_Artefatos
